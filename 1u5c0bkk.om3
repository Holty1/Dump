void _fastcall Hooks::NewCPythonApplicationRenderGame(void*This, void* EDX)
{


	if (!Settings::PerformanceDisableRender)
	{
		return nCPythonApplicationRenderGame(This);
	}
	else
	{
		return;
	}

}


